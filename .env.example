# Instancia Supabase de ESTE cliente (una instancia separada por cliente, no compartida)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOLO se usa en el servidor (src/lib/supabase-admin.ts).
# NUNCA le pongas el prefijo NEXT_PUBLIC_: eso la expondría en el navegador.
# Hasta que exista autenticación de usuarios finales, todo el backend de
# Next.js (Server Components y Server Actions) lee y escribe con esta key,
# ignorando RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=
